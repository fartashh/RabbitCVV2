rules_version = '2';

// Starting point: deny everything by default (matches what Firestore
// "production mode" already enforces server-side). KAN-3/KAN-4 will add
// scoped rules for resumes as we build the fields that need them —
// intentionally not writing speculative rules for data shapes that don't
// exist in the code yet.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
