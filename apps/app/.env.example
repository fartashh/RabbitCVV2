# Copy this to .env.local and fill in with the values from the Firebase
# console (Project settings > General > Your apps > SDK setup and
# configuration). These are not secrets — they identify the project, not
# authenticate anything — but env vars keep it easy to point dev/staging/
# prod at different Firebase projects later.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
